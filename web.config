<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <!-- Cache static files for an hour; config/library JSON is always re-checked by the page. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.01:00:00" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <!-- Never tell destination sites which page the click came from. -->
        <add name="Referrer-Policy" value="no-referrer" />
        <!-- Stop browsers pre-resolving every linked domain via DNS. -->
        <add name="X-DNS-Prefetch-Control" value="off" />
        <!-- The page may only load files from this server. No CDNs, fonts, favicons or trackers. -->
        <add name="Content-Security-Policy" value="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        <add name="X-Robots-Tag" value="noindex, nofollow" />
      </customHeaders>
    </httpProtocol>

    <!-- Keep repository files out of view if the whole repo is deployed. -->
    <security>
      <!-- On IIS 10 (Server 2016 1709+, 2019, 2022) you can also add removeServerHeader="true"
           to the requestFiltering element below to drop the "Server: Microsoft-IIS" header.
           On older IIS that attribute causes a 500.19 error. -->
      <requestFiltering>
        <hiddenSegments>
          <add segment="docs" />
          <add segment="deploy" />
          <add segment=".github" />
          <add segment="README.md" />
          <add segment="CHANGELOG.md" />
          <add segment="CONTRIBUTING.md" />
          <add segment="SECURITY.md" />
          <add segment="LICENSE" />
          <add segment=".htaccess" />
        </hiddenSegments>
      </requestFiltering>
    </security>


  </system.webServer>
</configuration>
